# =============================================================================
# LOCAL DEVELOPMENT ONLY — Dulce María Repostería
#
# Env vars for the docker-compose.yml dev stack at the repo root. This has
# nothing to do with production (cPanel shared hosting + phpPgAdmin) and is
# never read by the real deploy. Copy this file to a root-level `.env`
# (docker compose auto-loads that file) and edit values if you want:
#
#   cp docker/env.example .env
#
# Every value below is a clearly-fake local-only placeholder. Do NOT reuse
# any of these for a real/production credential.
# =============================================================================

# --- Postgres (db service) --------------------------------------------------
POSTGRES_DB=dulcemaria_dev
POSTGRES_USER=dulcemaria
POSTGRES_PASSWORD=dulcemaria_local_dev_pw

# --- Backend (dulcemaria-api) -----------------------------------------------
# Must be >= 32 characters (enforced by src/config/env.js). This is a fake
# local-only placeholder — never use it anywhere real.
JWT_SECRET=local-dev-only-jwt-secret-change-me-0123456789

# Only needed once, to create the first SUPERADMIN user via the bootstrap
# endpoint (the repo's own `npm run seed:superadmin` script is broken — it
# requires @prisma/client, which isn't installed — so this is the supported
# path locally). See docker/README.md for the curl example.
BOOTSTRAP_TOKEN=local-dev-bootstrap-token-change-me
ADMIN_EMAIL=admin@dulcemaria.local
ADMIN_PASSWORD=ChangeMe123!

# --- Frontend (Frontend/dulcemaria-web) & Sitio_web -------------------------
# These are already wired directly in docker-compose.yml as
# NUXT_PUBLIC_API_BASE / VITE_API_BASE (both http://localhost:4301, the
# host-exposed backend port — must stay `localhost` since these vars are
# resolved by the browser, not by the container network). Listed here only
# for reference; you do not need to set them yourself unless overriding.
# NUXT_PUBLIC_API_BASE=http://localhost:4301
# VITE_API_BASE=http://localhost:4301
